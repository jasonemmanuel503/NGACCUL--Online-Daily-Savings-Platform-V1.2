# Campay Mobile Money Gateway (Cameroon)
CAMPAY_APP_USERNAME=""
CAMPAY_APP_PASSWORD=""
CAMPAY_ENVIRONMENT="sandbox" 

# SMS Gateway (Nexah by default - Cameroon-based, direct connections to
# MTN Cameroon and Orange Cameroon. Africa's Talking treats Cameroon as an
# "International Market" - routed, not a direct local carrier connection -
# so it's a worse fit than Nexah for time-sensitive OTP delivery here.
# Get credentials from: https://nexah.net (contact: support@nexah.net)
# If left blank, SMS sends run in simulated mode (logged to console, not sent).
SMS_GATEWAY_USERNAME=""
SMS_GATEWAY_PASSWORD=""
SMS_SENDER_ID="NGACCUL"

# Newer Nexah Token-Based API Config
# If NEXAH_API_TOKEN is set, the system uses the modern Token Portal at sms.nexah.net.
NEXAH_API_TOKEN=""
NEXAH_SENDER_ID="NGACCUL"


# FuturaPay Payment Gateway (Primary provider for MTN and Orange Money)
# Get these from your FuturaPay merchant dashboard:
#   Merchant > My Profile > Merchant Key
#   Merchant > Settings > Services > Site ID & API Key
# If left blank, the app runs FuturaPay in simulated/sandbox fallback mode (no real charges).
FUTURAPAY_MERCHANT_KEY="6a54f97a05284"
FUTURAPAY_SITE_ID="588963229"
FUTURAPAY_API_KEY="apiKey6a55457ff3bc5"
FUTURAPAY_ENVIRONMENT="sandbox"
# ^ "sandbox" uses stage-api.futurapay.com, "production" uses api.futurapay.com

# Payment Providers (Options: "futurapay", "campay", "mtn_direct", "orange_direct")
# FuturaPay is the default/primary gateway. Campay is kept only as a fallback option;
# leave its keys above blank in production if you don't intend to use it.
PAYMENT_PROVIDER_MTN="futurapay"
PAYMENT_PROVIDER_ORANGE="futurapay"

# CRON_SECRET: Set this in Vercel Project Settings > Environment Variables (not required
# locally). Vercel automatically sends it as `Authorization: Bearer <CRON_SECRET>` on every
# invocation of a scheduled function defined in vercel.json -> "crons". The
# /api/cron/reconcile-payments route accepts this OR x-internal-token, so scheduled runs work
# without needing INTERNAL_API_SECRET exposed anywhere in the cron config itself.
CRON_SECRET="JBSWY3DPEHPK3PXP6RTGGZQBWQ2VMWDH"

# VITE_DISABLE_BUSINESS_HOURS: Set to "true" (e.g. in Vercel env vars or .env) to bypass
# the 8am-4pm Mon-Sat business hours check everywhere it's enforced client-side (UI gate
# only). Must be paired with DISABLE_BUSINESS_HOURS below for deposits/withdrawals/
# registrations to actually go through outside business hours — this variable alone only
# affects what the UI shows, not what the backend accepts. Set back to false/unset before
# going live.
VITE_DISABLE_BUSINESS_HOURS="false"

# DISABLE_BUSINESS_HOURS: Backend counterpart to VITE_DISABLE_BUSINESS_HOURS above. Set to
# "true" to bypass the server-side business hours check that actually rejects deposit/
# withdrawal/registration requests made outside 8am-4pm Mon-Sat. Both flags must be set
# together to fully disable the restriction. Set back to false/unset before going live.
DISABLE_BUSINESS_HOURS="false"
